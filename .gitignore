# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
*.local

# 运行期数据与日志（不入库）
logs/*.log
logs/*.err.log
*.log
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/.secret_key
data/run/
data/results/*
!data/results/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# 本地配置与密钥（不入库）
backend/config.yaml
.env
*.env

# 第三方课程参考资料（设计输入，不入库；如需纳入可删除此行）
refrence/

# 图片与媒体资源（不入库）
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp

# 构建产物与二进制包（不入库）
*.jar
*.war
*.ear

# 前端生产构建产物（由 vite build 生成，FastAPI 运行时托管）
backend/app/static/
